{
  "name": "live-sports-tv",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "preview": "vite preview",
    "worker:types": "wrangler types --cwd worker --config wrangler.jsonc --strict-vars=false worker-configuration.d.ts",
    "worker:check": "tsc -p worker/tsconfig.json --noEmit",
    "worker:dry-run": "wrangler deploy --dry-run --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.2",
    "@tanstack/react-query": "5.101.4",
    "hls.js": "1.6.17",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "shaka-player": "5.2.4",
    "zod": "4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@types/node": "26.2.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.0",
    "eslint": "9.33.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "supabase": "2.113.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.1",
    "vite": "7.1.2",
    "vitest": "3.2.4",
    "wrangler": "4.120.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
