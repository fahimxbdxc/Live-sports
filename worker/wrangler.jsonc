{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "live-sports-tv-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "production",
    "SUPABASE_URL": "https://rdrhpvqagrnkhlhzcayu.supabase.co",
    "SPORTS_PROVIDER": "thesportsdb",
    "SPORTS_API_BASE": "https://www.thesportsdb.com/api/v1/json",
    "ALLOWED_ORIGINS": "http://localhost:5173,https://live-sports-tv.pages.dev"
  },
  "triggers": {
    "crons": ["*/5 * * * *", "7 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
